<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Mandrill.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No RequestedTheme: the app follows the Windows light/dark setting (ADR-0014). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  Explorer's item font for rows, headers, tree and the rename box (WinUI's default is 14 px Segoe UI Variable,
                  owner round 6 #7). Replaced at startup by the Windows icon-title font, which Explorer uses; this is the
                  fallback (Segoe UI 9 pt = 12 px).  -->
            <FontFamily x:Key="MandrillListFontFamily">Segoe UI</FontFamily>
            <x:Double x:Key="MandrillListFontSize">12</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
