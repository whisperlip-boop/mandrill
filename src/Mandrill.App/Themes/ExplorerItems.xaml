<?xml version="1.0" encoding="utf-8" ?>
<!--
    Explorer's item look for the file list, the folder tree and the search results (owner F16, F19), merged into those
    views' Resources: lightweight styling of the ListViewItem / GridViewItem / TreeViewItem state brushes plus the
    content background. WinUI's defaults give a selected row the same fill as a hovered one (SubtleFillColorSecondary).
    Light and dark values are Windows 11 Explorer's (ItemsView::ListView theme parts: hot, selected, hot+selected, and
    selected-not-focus for an inactive pane); Explorer's colours have no system resource, so they are the only colour
    literals in the app besides Themes/HighContrast.xaml. High contrast overrides no item brush: the system colours stay.
    Secondary row text (Details columns, placeholder glyphs) is the row foreground at an opacity equal to WinUI's
    TextFillColorSecondary / Tertiary alpha over Primary, so a selected row's foreground (black on a high-contrast
    highlight) reaches it too; high contrast uses full opacity. The selection bar, the check
    mark and the selected border are turned off in FileListView.ApplySelectionBrush: x:Boolean and Thickness overrides here
    do not reach the item templates (only brushes do). Keys that the views' Style setters use live here, not in
    Brushes.xaml: a setter that resolved to the High contrast palette merged into the view re-resolves only within the
    view's Resources once the palette is removed, so an app-level key there is not found (crash 0x800F1000).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MandrillContentBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MandrillItemHoverBrush" Color="#E5F3FF" />
            <SolidColorBrush x:Key="MandrillItemSelectedBrush" Color="#CCE8FF" />
            <SolidColorBrush x:Key="MandrillItemSelectedHoverBrush" Color="#CCE8FF" />
            <SolidColorBrush x:Key="MandrillItemFocusBorderBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="MandrillInactiveSelectionBrush" Color="#D9D9D9" />
            <Thickness x:Key="MandrillItemFocusThickness">1</Thickness>
            <Thickness x:Key="MandrillItemFocusSecondaryThickness">0</Thickness>
            <x:Double x:Key="MandrillRowSecondaryOpacity">0.693</x:Double><!--  0x9E / 0xE4  -->
            <x:Double x:Key="MandrillRowTertiaryOpacity">0.5</x:Double><!--  0x72 / 0xE4  -->
            <!--  Header dividers (WP-2): Explorer draws #E5E5E5 on white; ListLow (10 % black; 10 % white in Dark) is the closest token.  -->
            <StaticResource x:Key="MandrillColumnDividerBrush" ResourceKey="SystemControlForegroundListLowBrush" />

            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="MandrillItemHoverBrush" />
            <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="MandrillItemSelectedHoverBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="GridViewItemBackgroundPointerOver" ResourceKey="MandrillItemHoverBrush" />
            <StaticResource x:Key="GridViewItemBackgroundPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelected" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelectedPointerOver" ResourceKey="MandrillItemSelectedHoverBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelectedPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundPointerOver" ResourceKey="MandrillItemHoverBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="MandrillItemSelectedHoverBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundSelectedPressed" ResourceKey="MandrillItemSelectedBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MandrillContentBackgroundBrush" Color="#191919" />
            <SolidColorBrush x:Key="MandrillItemHoverBrush" Color="#4D4D4D" />
            <SolidColorBrush x:Key="MandrillItemSelectedBrush" Color="#626262" />
            <SolidColorBrush x:Key="MandrillItemSelectedHoverBrush" Color="#505050" />
            <SolidColorBrush x:Key="MandrillItemFocusBorderBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="MandrillInactiveSelectionBrush" Color="#333333" />
            <Thickness x:Key="MandrillItemFocusThickness">1</Thickness>
            <Thickness x:Key="MandrillItemFocusSecondaryThickness">0</Thickness>
            <x:Double x:Key="MandrillRowSecondaryOpacity">0.773</x:Double><!--  0xC5 / 0xFF  -->
            <x:Double x:Key="MandrillRowTertiaryOpacity">0.529</x:Double><!--  0x87 / 0xFF  -->
            <StaticResource x:Key="MandrillColumnDividerBrush" ResourceKey="SystemControlForegroundListLowBrush" />

            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="MandrillItemHoverBrush" />
            <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="MandrillItemSelectedHoverBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="GridViewItemBackgroundPointerOver" ResourceKey="MandrillItemHoverBrush" />
            <StaticResource x:Key="GridViewItemBackgroundPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelected" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelectedPointerOver" ResourceKey="MandrillItemSelectedHoverBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelectedPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundPointerOver" ResourceKey="MandrillItemHoverBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundPressed" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="MandrillItemSelectedBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="MandrillItemSelectedHoverBrush" />
            <StaticResource x:Key="TreeViewItemBackgroundSelectedPressed" ResourceKey="MandrillItemSelectedBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="MandrillContentBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MandrillItemFocusBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="MandrillInactiveSelectionBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <Thickness x:Key="MandrillItemFocusThickness">2</Thickness>
            <Thickness x:Key="MandrillItemFocusSecondaryThickness">1</Thickness>
            <x:Double x:Key="MandrillRowSecondaryOpacity">1</x:Double>
            <x:Double x:Key="MandrillRowTertiaryOpacity">1</x:Double>
            <StaticResource x:Key="MandrillColumnDividerBrush" ResourceKey="SystemColorWindowTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  The item font (MandrillListFontFamily/Size) is an App resource: App.xaml.cs sets it to the Windows icon-title font.  -->
</ResourceDictionary>
