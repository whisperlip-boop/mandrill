<?xml version="1.0" encoding="utf-8" ?>
<!--
    One pane (ui-spec §2): reserved tab row, toolbar (tree toggle, back, forward, up, new folder, view mode, refresh,
    search, overflow »), path box, tree column (filled in WP-1.9) and the file list.
-->
<UserControl
    x:Class="Mandrill.App.Views.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Mandrill.App.Markup"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:v="using:Mandrill.App.Views"
    KeyboardAcceleratorPlacementMode="Hidden">
    <UserControl.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <!--
        Active pane (ui-spec §2): a 1 px neutral frame (+1 px padding) always, and a 1 px accent frame over it when active (2 px in high contrast),
        so nothing moves. Both brushes are ThemeResources and follow light/dark/high contrast at runtime.
    -->
    <Grid>
    <Border
        x:Name="Frame"
        Padding="1"
        BorderBrush="{ThemeResource MandrillPaneBorderBrush}"
        BorderThickness="1">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <!--  Reserved for the deferred coloured tabs (ui-spec §7).  -->
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="Toolbar"
            Grid.Row="1"
            Padding="4,2"
            ColumnSpacing="2">
            <!--  Owner F13: hover and pressed feedback for the transparent toolbar buttons (Themes/SubtleButtons.xaml).  -->
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///Themes/SubtleButtons.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TreeButton" Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="BackButton"
                Grid.Column="1"
                Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="ForwardButton"
                Grid.Column="2"
                Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="UpButton"
                Grid.Column="3"
                Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="NewFolderButton"
                Grid.Column="4"
                Style="{StaticResource ToolButtonStyle}" />
            <DropDownButton
                x:Name="ViewButton"
                Grid.Column="5"
                Height="28"
                Padding="5,4"
                Background="Transparent"
                BorderThickness="0" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="6"
                Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="SearchButton"
                Grid.Column="7"
                Style="{StaticResource ToolButtonStyle}" />
            <DropDownButton
                x:Name="OverflowButton"
                Grid.Column="8"
                Height="28"
                Padding="6,4"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed" />
            <v:PathBox
                x:Name="PathInput"
                Grid.Column="9"
                Margin="4,0,0,0" />
        </Grid>

        <Grid
            x:Name="Body"
            Grid.Row="2"
            BorderBrush="{ThemeResource MandrillPaneBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="240" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <!--  Tree panel: WP-1.9. The column, its width and the toggle already work.  -->
            <Border
                x:Name="TreeHost"
                AutomationProperties.Name="{m:Tr Key=pane.tree}"
                BorderBrush="{ThemeResource MandrillPaneBorderBrush}"
                BorderThickness="0,0,1,0" />
            <tk:GridSplitter
                x:Name="TreeSplitter"
                Grid.Column="1"
                AutomationProperties.Name="{m:Tr Key=pane.treeSplitter}"
                Width="5"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns" />
            <v:FileListView x:Name="Files" Grid.Column="2" />
            <!--  ADR-0015: shown instead of the file list while the pane is at This PC.  -->
            <v:DriveListView x:Name="DriveRows" Grid.Column="2" Visibility="Collapsed" />
        </Grid>
    </Grid>
    </Border>
    <Border
        x:Name="ActiveFrame"
        BorderBrush="{ThemeResource MandrillActivePaneBorderBrush}"
        BorderThickness="1"
        IsHitTestVisible="False" />
    </Grid>
</UserControl>
