<?xml version="1.0" encoding="utf-8" ?>
<!--
    One pane (ui-spec §2): tab row (PaneTabStrip, §2a; Details / Large icons buttons at its right end), toolbar (tree toggle, back, forward, up, new folder, view mode, refresh,
    search, overflow »), path box, tree column (filled in WP-1.9) and the file list.
-->
<UserControl
    x:Class="Mandrill.App.Views.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Mandrill.App.Markup"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:v="using:Mandrill.App.Views"
    KeyboardAcceleratorPlacementMode="Hidden">
    <UserControl.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ViewModeButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <!--
        Active pane (ui-spec §2): a 1 px neutral frame (+1 px padding) always, and a 1 px accent frame over it when active (2 px in high contrast),
        so nothing moves. Both brushes are ThemeResources and follow light/dark/high contrast at runtime.
    -->
    <Grid>
    <Border
        x:Name="Frame"
        Padding="1"
        BorderBrush="{ThemeResource MandrillPaneBorderBrush}"
        BorderThickness="1">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <!--  The tab row: exactly 24 px, owner's hard rule (ui-spec §2a); nothing below may move down.  -->
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  First in the pane's Tab order (ui-spec §7); the view buttons, declared last, sit above its strip.  -->
        <v:PaneTabStrip x:Name="TabRow" />

        <Grid
            x:Name="Toolbar"
            Grid.Row="1"
            Padding="4,2"
            ColumnSpacing="2">
            <!--  Owner F13: hover and pressed feedback for the transparent toolbar buttons (Themes/SubtleButtons.xaml).  -->
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///Themes/SubtleButtons.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TreeButton" Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="BackButton"
                Grid.Column="1"
                Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="ForwardButton"
                Grid.Column="2"
                Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="UpButton"
                Grid.Column="3"
                Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="NewFolderButton"
                Grid.Column="4"
                Style="{StaticResource ToolButtonStyle}" />
            <DropDownButton
                x:Name="ViewButton"
                Grid.Column="5"
                Height="28"
                Padding="5,4"
                Background="Transparent"
                BorderThickness="0" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="6"
                Style="{StaticResource ToolButtonStyle}" />
            <Button
                x:Name="SearchButton"
                Grid.Column="7"
                Style="{StaticResource ToolButtonStyle}" />
            <DropDownButton
                x:Name="OverflowButton"
                Grid.Column="8"
                Height="28"
                Padding="6,4"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed" />
            <v:PathBox
                x:Name="PathInput"
                Grid.Column="9"
                Margin="4,0,0,0" />
        </Grid>

        <Grid
            x:Name="Body"
            Grid.Row="2"
            BorderBrush="{ThemeResource MandrillPaneBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="240" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  Tree panel: WP-1.9. The column, its width and the toggle already work.  -->
            <Border
                x:Name="TreeHost"
                Grid.RowSpan="2"
                AutomationProperties.Name="{m:Tr Key=pane.tree}"
                BorderBrush="{ThemeResource MandrillPaneBorderBrush}"
                BorderThickness="0,0,1,0" />
            <tk:GridSplitter
                x:Name="TreeSplitter"
                Grid.Column="1"
                Grid.RowSpan="2"
                AutomationProperties.Name="{m:Tr Key=pane.treeSplitter}"
                Width="5"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns" />
            <!--  Quick filter (ui-spec §2b): 28 px above the list, on demand or always (Settings → Filter bar).  -->
            <Grid
                x:Name="FilterRow"
                Grid.Column="2"
                Height="28"
                Padding="4,2"
                BorderBrush="{ThemeResource MandrillPaneBorderBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="6"
                Visibility="Collapsed">
                <Grid.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="ms-appx:///Themes/SubtleButtons.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="FilterBox"
                    MinHeight="0"
                    Padding="8,2,8,2"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{m:Tr Key=pane.filter.box}"
                    PlaceholderText="{m:Tr Key=pane.filter.box}" />
                <TextBlock
                    x:Name="FilterCount"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    x:Name="FilterCloseButton"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Padding="6"
                    Background="Transparent"
                    BorderThickness="0" />
            </Grid>
            <v:FileListView x:Name="Files" Grid.Row="1" Grid.Column="2" />
            <!--  ADR-0015: shown instead of the file list while the pane is at This PC.  -->
            <v:DriveListView x:Name="DriveRows" Grid.Row="1" Grid.Column="2" Visibility="Collapsed" />
        </Grid>

        <!--
            Explorer's status-bar view buttons (Details, Large icons) at the right end of the tab row, over the tab strip's
            2 px colour strip. Declared last so they are the pane's last Tab stops, like Explorer's.
        -->
        <StackPanel
            x:Name="ViewModeButtons"
            Margin="0,0,4,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="2">
            <StackPanel.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///Themes/SubtleButtons.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                    <!--  QA F3: high contrast fills disabled toggles with Window, which cut the tab strip under them (This PC).  -->
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
                </ResourceDictionary>
            </StackPanel.Resources>
            <!--  Quick filter toggle (ui-spec §2b): left of Explorer's pair, which stays at the right end.  -->
            <ToggleButton x:Name="FilterToggle" Style="{StaticResource ViewModeButtonStyle}" />
            <ToggleButton x:Name="DetailsViewButton" Style="{StaticResource ViewModeButtonStyle}" />
            <ToggleButton x:Name="LargeIconsViewButton" Style="{StaticResource ViewModeButtonStyle}" />
        </StackPanel>
    </Grid>
    </Border>
    <Border
        x:Name="ActiveFrame"
        BorderBrush="{ThemeResource MandrillActivePaneBorderBrush}"
        BorderThickness="1"
        IsHitTestVisible="False" />
    </Grid>
</UserControl>
