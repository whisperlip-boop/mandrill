<?xml version="1.0" encoding="utf-8" ?>
<!--
    The This PC drive list of one pane (ADR-0015, PC3): fixed Details columns Name (Shell icon + name), Type, Total size,
    Free space, in drive-letter order. A handful of rows, so no virtualization tricks; rows are filled in code.
-->
<UserControl
    x:Class="Mandrill.App.Views.DriveListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Mandrill.App.Markup">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/ExplorerItems.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DriveRowStyle" TargetType="ListViewItem">
                <Setter Property="FontFamily" Value="{ThemeResource MandrillListFontFamily}" />
                <Setter Property="FontSize" Value="{ThemeResource MandrillListFontSize}" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource MandrillListFontFamily}" />
                <Setter Property="FontSize" Value="{ThemeResource MandrillListFontSize}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{ThemeResource MandrillContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--
            QA S3-1, the file list's Details behaviour: Type, Total size and Free space keep fixed widths; Name takes the rest
            down to 120 (the file list's Name minimum) and trims; below that the rows scroll sideways and the header follows.
            Column 0 widths are set in code (DriveListView.ApplyNameWidth).
        -->
        <Grid x:Name="HeaderClip" Height="26">
            <Grid.Clip>
                <RectangleGeometry x:Name="HeaderClipRect" />
            </Grid.Clip>
            <Grid x:Name="Header" HorizontalAlignment="Left" Padding="8,0,8,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="{m:Tr Key=pane.column.name}" />
                <TextBlock Grid.Column="1" Style="{StaticResource HeaderTextStyle}" Text="{m:Tr Key=pane.column.type}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource HeaderTextStyle}" Text="{m:Tr Key=thispc.column.total}" />
                <TextBlock Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource HeaderTextStyle}" Text="{m:Tr Key=thispc.column.free}" />
            </Grid>
        </Grid>
        <ListView
            x:Name="List"
            Grid.Row="1"
            AutomationProperties.Name="{m:Tr Key=thispc.list.name}"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource DriveRowStyle}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Auto"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Left" Padding="8,0,8,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
