<?xml version="1.0" encoding="utf-8" ?>
<!--  Editable path combobox (ui-spec §2 "Path combobox"): history dropdown, Enter navigates, Esc reverts.  -->
<UserControl
    x:Class="Mandrill.App.Views.PathBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Mandrill.App.Markup">
    <Grid VerticalAlignment="Center">
        <!--  IsTextSearchEnabled off (QA S3-7): no inline completion from the history; Enter opens exactly what was typed.  -->
        <ComboBox
            x:Name="Box"
            MinHeight="28"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="{m:Tr Key=pane.path}"
            IsEditable="True"
            IsTextSearchEnabled="False" />
        <!--  Error outline over the box: the focused editor draws its own border (accent underline, HC yellow) above the ComboBox's.  -->
        <Border
            x:Name="ErrorOutline"
            BorderBrush="{ThemeResource MandrillPathErrorBrush}"
            BorderThickness="2"
            CornerRadius="{Binding CornerRadius, ElementName=Box}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
