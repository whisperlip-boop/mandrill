<?xml version="1.0" encoding="utf-8" ?>
<!--
    Pane area (architecture §6, ADR-0012): one 3×3 grid [pane, 5 px splitter, pane] on both axes for all 8 layouts.
    The four PaneViews are re-parented into it per LayoutSpec; they are never rebuilt.
-->
<UserControl
    x:Class="Mandrill.App.Views.LayoutHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Mandrill.App.Markup"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <Grid x:Name="LayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="120" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="120" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>
        <tk:GridSplitter
            x:Name="ColumnSplitter"
            Grid.Column="1"
            AutomationProperties.Name="{m:Tr Key=window.splitter.columns}"
            Canvas.ZIndex="1"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />
        <tk:GridSplitter
            x:Name="RowSplitter"
            Grid.Row="1"
            AutomationProperties.Name="{m:Tr Key=window.splitter.rows}"
            Canvas.ZIndex="1"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows" />
    </Grid>
</UserControl>
