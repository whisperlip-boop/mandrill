<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Mandrill.Core</RootNamespace>
    <MandrillNoUi>true</MandrillNoUi>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Mandrill ships win-x64 only; some shell structs (SHFILEINFOW, SHELLEXECUTEINFOW) are arch-specific. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="NReco.Logging.File" Version="1.4.0" />
    <!-- XxHash64 trailer of the index files (architecture §8.3, ADR-0005). -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Interop\NativeMethods.txt" />
    <AdditionalFiles Include="Interop\NativeMethods.json" />
    <Content Include="Locales\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mandrill.Core.Tests" />
    <InternalsVisibleTo Include="Mandrill.Presentation.Tests" />
  </ItemGroup>
</Project>
